# Application
VITE_API_BASE_URL=/api
# true = mocks MSW (déterministes, hors ligne) ; false = données réelles RTE
VITE_ENABLE_MOCKS=true
VITE_COOKIE_BASE_NAME=app

# RTE — API "Actual Generation" (data.rte-france.com)
# Clé au format base64("client_id:client_secret") (l'identifiant affiché sur
# https://data.rte-france.com après abonnement à l'API "Actual Generation").
# L'app utilise le flux OAuth2 : POST {base}/token/oauth/ → token Bearer pour les données.
# VITE_RTE_BASE_URL pointe directement sur l'hôte RTE. Attention : le serveur RTE ne
# renvoie pas d'en-tête CORS — une requête navigateur cross-origin sera bloquée par le
# navigateur. En préproduction/production, relayez derrière un proxy serveur côté app.
VITE_RTE_IDENTIFIER=
VITE_RTE_BASE_URL=https://digital.iservices.rte-france.com