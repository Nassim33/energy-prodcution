{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": true,
  "ignorePatterns": ["dist", "coverage", "pnpm-lock.yaml", "src/routeTree.gen.ts", "src/api/gen"],
}
