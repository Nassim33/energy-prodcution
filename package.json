{
  "name": "react-starter-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b --noEmit",
    "generate": "kubb generate",
    "prepare": "husky",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "@tanstack/react-router": "^1.95.0",
    "antd": "^5.22.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@kubb/cli": "^3.5.0",
    "@kubb/core": "^3.5.0",
    "@kubb/plugin-client": "^3.5.0",
    "@kubb/plugin-oas": "^3.5.0",
    "@kubb/plugin-react-query": "^3.5.0",
    "@kubb/plugin-ts": "^3.5.0",
    "@kubb/plugin-zod": "^3.5.0",
    "@tanstack/react-query-persist-client": "^5.62.0",
    "@tanstack/react-router-devtools": "^1.95.0",
    "@tanstack/router-plugin": "^1.95.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "msw": "^2.7.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^0.15.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,css}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
